# --- CONTAINER BANCO DE DADOS (POSTGRES) ---
POSTGRES_DB=cyberconexo
POSTGRES_USER=cyberuser
POSTGRES_PASSWORD=troque_esta_senha

# --- CONTAINER DE GERENCIAMENTO (PGADMIN) ---
# Use um e-mail com formato válido e uma senha segura
PGADMIN_DEFAULT_EMAIL=admin@cyberconexo.com
PGADMIN_DEFAULT_PASSWORD=troque_esta_senha_pgadmin

# pgAdmin só no localhost da VM. Use 0.0.0.0 apenas se realmente precisar abrir para a rede.
PGADMIN_BIND=127.0.0.1

# --- CONFIGURAÇÕES DE REDE DA VM ---
# Porta pela qual o jogo fica disponível na VM (80 = http://IP-da-VM)
HTTP_PORT=80

# --- CONFIGURAÇÕES DO BACKEND (SPRING BOOT) ---
# Se rodar o jar local: use localhost. Se rodar no Docker: altere para o nome do serviço (ex: jdbc:postgresql://db:5432/cyberconexo)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cyberconexo
SPRING_DATASOURCE_USERNAME=cyberuser
SPRING_DATASOURCE_PASSWORD=troque_esta_senha

# --- DOCUMENTAÇÃO & SEGURANÇA ---
# Swagger UI da API (/swagger-ui.html no backend). Deixe false fora de desenvolvimento.
SWAGGER_ENABLED=false

# CORS (Exemplo: http://localhost:5500 ou deixe em branco se não usar fora do Nginx)
CORS_ALLOWED_ORIGINS=http://localhost:5500